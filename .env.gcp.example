# Google Cloud Compute Engine e2-micro + Tailscale Funnel
# Configure actual secrets on the VM only. Never commit the populated .env.
DISCORD_TOKEN=replace_with_bot_token
DISCORD_CLIENT_ID=replace_with_application_id
DISCORD_CLIENT_SECRET=replace_with_oauth_client_secret

# Copy the full, stable https://...ts.net/auth/callback URL from Tailscale.
# Register exactly this URI in Discord Developer Portal > OAuth2 > Redirects.
DISCORD_REDIRECT_URI=https://replace-me.example.ts.net/auth/callback
COOKIE_SECURE=true

# Never expose this local Uvicorn port directly on the VM firewall.
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=/var/lib/voice-hub/voice_hub.sqlite3
