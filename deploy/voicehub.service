[Unit]
Description=Discord Voice Hub (Bot + Web Dashboard)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=voicehub
Group=voicehub
WorkingDirectory=/opt/voice-hub
EnvironmentFile=/opt/voice-hub/.env
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/test -x /usr/bin/ffmpeg
ExecStartPre=/usr/bin/test -x /usr/local/bin/deno
ExecStart=/opt/voice-hub/.venv/bin/python -m uvicorn app.server:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077

# The service reads source code and credentials, but only writes its DB directory.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/voice-hub
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
