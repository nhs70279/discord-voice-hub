# Northflank: service runtime variables only; do not commit real secrets.
# Set these in the service's Environment variables screen, not in GitHub.
COOKIE_SECURE=true
DATABASE_PATH=/data/voice_hub.sqlite3
DISCORD_CLIENT_ID=replace_with_discord_application_id
DISCORD_CLIENT_SECRET=replace_with_discord_oauth_client_secret
DISCORD_TOKEN=replace_with_discord_bot_token
DISCORD_REDIRECT_URI=https://REPLACE_WITH_ACTUAL_PUBLIC_CODE_RUN_HOST/auth/callback
