# Oracle Cloud Always Free + Cloudflare Tunnel
# Do not publish this file after adding real credentials.
DISCORD_TOKEN=replace_with_bot_token
DISCORD_CLIENT_ID=replace_with_application_id
DISCORD_CLIENT_SECRET=replace_with_oauth_client_secret

# Must match the Discord Developer Portal OAuth2 redirect EXACTLY.
# Requires a stable hostname from a domain managed in Cloudflare.
DISCORD_REDIRECT_URI=https://bot.example.com/auth/callback
COOKIE_SECURE=true

# The dashboard only listens locally; Cloudflare Tunnel forwards to it.
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=/var/lib/voice-hub/voice_hub.sqlite3
