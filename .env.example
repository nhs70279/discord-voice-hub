DISCORD_TOKEN=replace_with_bot_token
DISCORD_CLIENT_ID=replace_with_application_id
DISCORD_CLIENT_SECRET=replace_with_oauth_client_secret
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
HOST=127.0.0.1
PORT=8000
COOKIE_SECURE=false
DATABASE_PATH=voice_hub.sqlite3
# Fixed Thai TTS voice per bot instance: google (fast, reliable) or edge (neural).
LILIN_TTS_ENGINE=google
# Pre-generate a silent warm-up Thai voice clip in the background at bot startup.
# Disable only for troubleshooting: LILIN_TTS_WARMUP=0
LILIN_TTS_WARMUP=1
# Optional on server only: Netscape YouTube cookies; file must be chmod 600.
# YOUTUBE_COOKIES_PATH=data/youtube-cookies.txt
# Optional: path to a preinstalled bgutil-ytdlp-pot-provider/server directory.
# Never expose its local HTTP service publicly; YOUTUBE_POT_READY is set by startup.
# YOUTUBE_POT_SERVER_HOME=data/bgutil-ytdlp-pot-provider/server

